{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@seany9915/eolas-ui",
  "homepage": "https://github.com/seany9915/eolas-ui",
  "include": [
    "src/components/ui/registry.json",
    "src/components/blocks/registry.json"
  ],
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Eolas UI Utilities",
      "description": "Core utility library exporting cn(), assetUrl(), sanitizeUrl(), composeClassName(), resolveNativeButton(), and Base UI authoring hooks: mergeProps(), mergePropsN(), mergeClassNames(), makeEventPreventable(), and useRender().",
      "categories": [
        "system"
      ],
      "dependencies": [
        "@base-ui/react",
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
    {
      "name": "announce",
      "type": "registry:lib",
      "title": "Announce",
      "description": "Imperative screen-reader live-region announcer.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/announce.ts",
          "type": "registry:lib",
          "target": "@lib/announce.ts"
        }
      ]
    },
    {
      "name": "built-in-ai",
      "type": "registry:lib",
      "title": "Built-in AI",
      "description": "On-device Built-in AI Hooks (Prompt API, Language Detector, Summarizer & Translator).",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/built-in-ai.ts",
          "type": "registry:lib",
          "target": "@lib/built-in-ai.ts"
        }
      ]
    },
    {
      "name": "contrast",
      "type": "registry:lib",
      "title": "Contrast",
      "description": "Dynamic foreground contrast helper for user-supplied background colors.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/contrast.ts",
          "type": "registry:lib",
          "target": "@lib/contrast.ts"
        }
      ]
    },
    {
      "name": "format-duration",
      "type": "registry:lib",
      "title": "Format Duration",
      "description": "Duration Formatting Utility and Hook",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/format-duration.ts",
          "type": "registry:lib",
          "target": "@lib/format-duration.ts"
        }
      ]
    },
    {
      "name": "sanitize",
      "type": "registry:lib",
      "title": "Sanitize",
      "description": "Untrusted HTML Sanitizer Utility & React Component.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/sanitize.ts",
          "type": "registry:lib",
          "target": "@lib/sanitize.ts"
        }
      ]
    },
    {
      "name": "scheduler",
      "type": "registry:lib",
      "title": "Scheduler",
      "description": "Cooperative Task Scheduling & Yielding Utilities.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/scheduler.ts",
          "type": "registry:lib",
          "target": "@lib/scheduler.ts"
        }
      ]
    },
    {
      "name": "scroll-completion",
      "type": "registry:lib",
      "title": "Scroll Completion",
      "description": "Programmatic scroll completion utilities.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/scroll-completion.ts",
          "type": "registry:lib",
          "target": "@lib/scroll-completion.ts"
        }
      ]
    },
    {
      "name": "use-horizontal-scroll-fade",
      "type": "registry:lib",
      "title": "Use Horizontal Scroll Fade",
      "description": "Horizontal scroll overflow detection for soft edge-fade masks.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/use-horizontal-scroll-fade.ts",
          "type": "registry:lib",
          "target": "@lib/use-horizontal-scroll-fade.ts"
        }
      ]
    },
    {
      "name": "use-text-highlight",
      "type": "registry:lib",
      "title": "Use Text Highlight",
      "description": "useTextHighlight Hook",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/use-text-highlight.ts",
          "type": "registry:lib",
          "target": "@lib/use-text-highlight.ts"
        }
      ]
    },
    {
      "name": "use-web-otp",
      "type": "registry:lib",
      "title": "Use Web OTP",
      "description": "WebOTP API auto-extraction hook.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/use-web-otp.ts",
          "type": "registry:lib",
          "target": "@lib/use-web-otp.ts"
        }
      ]
    },
    {
      "name": "view-transitions",
      "type": "registry:lib",
      "title": "View Transitions",
      "description": "View Transitions API React hook and utility.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/lib/view-transitions.ts",
          "type": "registry:lib",
          "target": "@lib/view-transitions.ts"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Eolas UI Clinical Theme",
      "description": "Tailwind CSS v4 theme, design tokens, color roles, surface hierarchies, Google Fonts & Material Symbols imports, and motion tokens conforming to DESIGN.md.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "src/globals.css",
          "type": "registry:file",
          "target": "~/src/eolas-theme.css"
        }
      ],
      "docs": "Includes Google Fonts @import rules for Atkinson Hyperlegible Next, Lexend, Roboto Mono, and Material Symbols Outlined, plus Tailwind CSS v4 @theme tokens and descendant-scoped inverted surface rules ([data-surface=\"inverted\"]). `npx shadcn@latest add @eolas/theme` writes the full Tailwind CSS v4 stylesheet to `src/eolas-theme.css` (import it from your entry point or main CSS file); `eolas-ui add theme` automatically writes to your `components.json` `tailwind.css` path when configured."
    },
    {
      "name": "design-md",
      "type": "registry:file",
      "title": "Eolas UI Design System Spec (DESIGN.md)",
      "description": "Canonical design tokens, color roles, surface hierarchy, typography, and motion rules for AI agents and developers.",
      "categories": [
        "system"
      ],
      "files": [
        {
          "path": "DESIGN.md",
          "type": "registry:file",
          "target": "~/DESIGN.md"
        }
      ]
    },
    {
      "name": "agent-rules",
      "type": "registry:item",
      "title": "Eolas UI Agent Rules & Anti-Pattern Checker",
      "description": "Strict architectural contracts, AGENTS.md, Antigravity hooks, DESIGN.md tokens, and anti-pattern enforcement scripts for AI agents and developers.",
      "categories": [
        "system"
      ],
      "registryDependencies": [
        "seany9915/eolas-ui/design-md"
      ],
      "files": [
        {
          "path": ".agents/rules/00-core-contract.md",
          "type": "registry:file",
          "target": "~/.agents/rules/00-core-contract.md"
        },
        {
          "path": ".agents/rules/anti-patterns.md",
          "type": "registry:file",
          "target": "~/.agents/rules/anti-patterns.md"
        },
        {
          "path": ".agents/rules/component-library.md",
          "type": "registry:file",
          "target": "~/.agents/rules/component-library.md"
        },
        {
          "path": ".agents/rules/design-system.md",
          "type": "registry:file",
          "target": "~/.agents/rules/design-system.md"
        },
        {
          "path": ".agents/hooks.json",
          "type": "registry:file",
          "target": "~/.agents/hooks.json"
        },
        {
          "path": ".agents/scripts/check-anti-patterns.mjs",
          "type": "registry:file",
          "target": "~/.agents/scripts/check-anti-patterns.mjs"
        },
        {
          "path": ".agents/scripts/check-primitive-inventory.mjs",
          "type": "registry:file",
          "target": "~/.agents/scripts/check-primitive-inventory.mjs"
        },
        {
          "path": ".agents/scripts/check-secrets.mjs",
          "type": "registry:file",
          "target": "~/.agents/scripts/check-secrets.mjs"
        },
        {
          "path": ".agents/scripts/check-oxlint-on-stop.mjs",
          "type": "registry:file",
          "target": "~/.agents/scripts/check-oxlint-on-stop.mjs"
        },
        {
          "path": "AGENTS.md",
          "type": "registry:file",
          "target": "~/AGENTS.md"
        }
      ],
      "docs": "For full AST lint enforcement (nested Card, sparkle icons, triple-tint, tertiary contrast, transition-all, spring easing, uppercase, unsafe type casts), also run: npx shadcn@latest add @eolas/lint (or npx @seany9915/eolas-ui add lint)."
    },
    {
      "name": "lint",
      "type": "registry:item",
      "title": "Eolas UI Lint",
      "description": "@shadcn/lint and Eolas UI Oxlint config for Base UI design contracts.",
      "categories": [
        "system"
      ],
      "devDependencies": [
        "@shadcn/lint",
        "oxlint"
      ],
      "files": [
        {
          "path": "packages/eolas-ui/lint/index.mjs",
          "type": "registry:file",
          "target": "~/lint/index.mjs"
        },
        {
          "path": "packages/eolas-ui/lint/consumer.oxlintrc.json",
          "type": "registry:file",
          "target": "~/.oxlintrc.json"
        }
      ],
      "docs": "Run \"npx oxlint .\" to enforce Eolas UI and @shadcn/lint contracts. If your UI primitives live outside src/components/ui or components/ui, add your custom directory glob to overrides[0].files in .oxlintrc.json."
    }
  ]
}