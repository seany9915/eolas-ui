{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@seany9915/eolas-ui",
  "homepage": "https://github.com/seany9915/eolas-ui",
  "include": [
    "src/components/ui/registry.json",
    "src/components/blocks/registry.json"
  ],
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Eolas UI Utilities",
      "description": "Core utility library exporting cn() class merger, assetUrl() resolver, and Base UI authoring hooks: mergeProps(), mergePropsN(), mergeClassNames(), makeEventPreventable(), and useRender().",
      "dependencies": [
        "clsx",
        "tailwind-merge",
        "@base-ui/react"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Eolas UI Clinical Theme",
      "description": "Tailwind CSS v4 theme, design tokens, color roles, surface hierarchies, and motion tokens conforming to DESIGN.md",
      "files": [
        {
          "path": "src/globals.css",
          "type": "registry:file",
          "target": "styles/globals.css"
        }
      ]
    },
    {
      "name": "agent-rules",
      "type": "registry:file",
      "title": "Eolas UI Agent Rules & Anti-Pattern Checker",
      "description": "Strict architectural contracts, DESIGN.md tokens, and anti-pattern enforcement scripts for AI agents and developers",
      "files": [
        {
          "path": ".agents/rules/00-core-contract.md",
          "type": "registry:file",
          "target": "~/.agents/rules/00-core-contract.md"
        },
        {
          "path": ".agents/rules/anti-patterns.md",
          "type": "registry:file",
          "target": "~/.agents/rules/anti-patterns.md"
        },
        {
          "path": ".agents/rules/component-library.md",
          "type": "registry:file",
          "target": "~/.agents/rules/component-library.md"
        },
        {
          "path": ".agents/rules/design-system.md",
          "type": "registry:file",
          "target": "~/.agents/rules/design-system.md"
        },
        {
          "path": ".agents/scripts/check-anti-patterns.mjs",
          "type": "registry:file",
          "target": "~/.agents/scripts/check-anti-patterns.mjs"
        }
      ]
    },
    {
      "name": "lint",
      "type": "registry:file",
      "title": "Eolas UI Lint",
      "description": "@shadcn/lint preset and ESLint config for Eolas UI Base UI design contracts",
      "devDependencies": [
        "@shadcn/lint",
        "eslint",
        "@typescript-eslint/parser"
      ],
      "files": [
        {
          "path": "packages/eolas-ui/lint/index.js",
          "type": "registry:file",
          "target": "~/lint/index.js"
        },
        {
          "path": "eslint.config.mjs",
          "type": "registry:file",
          "target": "~/eslint.config.mjs"
        }
      ]
    }
  ]
}